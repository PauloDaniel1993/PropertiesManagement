{
  "AllowedHosts": "*",
  "Alsappan": {
    "Database": {
      "ConnectionString": "Host=localhost;Port=5432;Database=alsappan;Username=alsappan;Password=alsappan_dev_password",
      "Schema": "app"
    },
    "Auth": {
      "Issuer": "Alsappan",
      "Audience": "Alsappan.Web",
      "SigningKey": "replace-this-dev-only-signing-key-with-at-least-32-characters",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30,
      "RefreshCookieName": "__Host-alsappan-refresh",
      "AccessTokenHeaderName": "Authorization"
    },
    "Storage": {
      "LocalPath": "./storage"
    },
    "Localization": {
      "DefaultCulture": "pt-BR",
      "SupportedCultures": [
        "pt-BR",
        "en-US"
      ]
    },
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:5173",
        "https://localhost:5173"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
